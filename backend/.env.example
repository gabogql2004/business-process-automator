# Postgres local — ajusta usuario/password/puerto a tu instalación
DATABASE_URL="postgresql://usuario:password@localhost:5432/business_process_automator?schema=public"

# Servidor
PORT=4000

# URL del frontend, usada para restringir CORS. En local: http://localhost:5173
# En producción: la URL real del frontend deployado (ej. https://tu-app.vercel.app)
FRONTEND_URL="http://localhost:5173"

# Auth
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Claude API (Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Sheets (Service Account) — usa UNA de las dos opciones:
# 1) Local: ruta a un archivo de credenciales (gitignored)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH="./credentials/google-service-account.json"
# 2) Producción: el JSON completo de las credenciales como string (no hay
#    filesystem persistente en la mayoría de los hosts). Si esta variable
#    está seteada, tiene prioridad sobre GOOGLE_SERVICE_ACCOUNT_KEY_PATH.
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Alertas por email (Resend)
RESEND_API_KEY="re_..."

# Código de invitación requerido para registrarse. Vacío/sin setear = registro
# abierto (así se deja en desarrollo local). En producción, setealo para que
# nadie pueda crear una cuenta y consumir tu ANTHROPIC_API_KEY sin permiso.
# REGISTRATION_CODE="elige-un-codigo"
